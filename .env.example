# Copy this file to .env and paste your key from dev.meta.ai > API Keys
MODEL_API_KEY=

# The Muse Spark model to use. If you get a "model not found" error, try muse-spark-1.1
MODEL=muse-spark-1.3

# Optional: minimal, low, medium, high. Lower is faster and cheaper.
# REASONING_EFFORT=low

# Optional: narration voice. Any Kokoro voice name, or "browser" to use the browser's voice.
# VOICE=af_heart

PORT=3000

# ---------- Only for a public server ----------
# Listen only on this machine, behind a web server like Caddy, and trust the address it forwards.
# HOST=127.0.0.1
# TRUST_PROXY=1

# Daily limits on what costs API credit (leave unset for no limit).
# LESSONS_PER_DAY=40
# LESSONS_PER_VISITOR_PER_DAY=5
# QUESTIONS_PER_DAY=300
# QUESTIONS_PER_VISITOR_PER_DAY=30
# MAX_BUILDS_AT_ONCE=2

# Each visitor sees only featured lessons plus their own. List lesson folder names to feature.
# GALLERY=private
# FEATURED_LESSONS=how-volcanoes-erupt-201978,where-rain-comes-from-a0f1e6
