# Copy this file to .env and paste your key from dev.meta.ai > API Keys
MODEL_API_KEY=

# The Muse Spark model to use. If you get a "model not found" error, try muse-spark-1.1
MODEL=muse-spark-1.3

# Optional: minimal, low, medium, high. Lower is faster and cheaper.
# REASONING_EFFORT=low

PORT=3000
